# Copy to .env — required. DATABASE_URL has no default and Prisma throws
# without it. Read by prisma.config.ts (CLI) and Nest (app).
#
# Postgres container settings live in the root .env.example.

# Mirrors POSTGRES_* / DB_PORT from the root .env: compose needs them split,
# Prisma needs one URL. Change one side, change the other.
DATABASE_URL=postgresql://app:app@localhost:5432/smart_contact_importer?schema=public

PORT=3000

# Dev value, committed on purpose. The app must NOT carry a fallback in code —
# a missing JWT_SECRET outside development has to fail fast.
JWT_SECRET=dev-ca978112ca1bbdcafac231b39a23dc4da
JWT_EXPIRES_IN=5d

# Where POST /v1/imports parks uploaded CSVs. A relative path resolves against
# backend/ (process.cwd()), and `uploads/` is gitignored. Created at boot — the
# first upload on a clean clone would otherwise 500 on a missing directory.
UPLOAD_DIR=./uploads

# 10 MiB. Multer aborts past this with LIMIT_FILE_SIZE, which Nest maps to 413.
# A 30k-row LinkedIn export is ~5 MB, so this fits a real file with room over.
# Must stay well under 2^31: ImportJob.byteSize is a 32-bit INTEGER.
MAX_UPLOAD_BYTES=10485760

# Optional. Unset ⇒ heuristic column inference. The import path works either
# way, so a reviewer with no key changes nothing here.
ANTHROPIC_API_KEY=


# Worker
WORKER_LEASE_SECONDS=60
WORKER_MAX_ATTEMPTS=3
WORKER_POLL_INTERVAL_MS=1000

# false ⇒ this process serves HTTP only and nothing drains the queue. Every
# instance polls by default; the claim is safe under N of them.
WORKER_ENABLED=true
