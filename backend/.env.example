# Copy to .env — required. DATABASE_URL has no default and Prisma throws
# without it. Read by prisma.config.ts (CLI) and Nest (app).
#
# Postgres container settings live in the root .env.example.

# Mirrors POSTGRES_* / DB_PORT from the root .env: compose needs them split,
# Prisma needs one URL. Change one side, change the other.
DATABASE_URL=postgresql://app:app@localhost:5432/smart_contact_importer?schema=public

PORT=3000

# Dev value, committed on purpose. The app must NOT carry a fallback in code —
# a missing JWT_SECRET outside development has to fail fast.
JWT_SECRET=dev-only-not-a-secret
JWT_EXPIRES_IN=5d

# Optional. Unset ⇒ heuristic column inference. The import path works either
# way, so a reviewer with no key changes nothing here.
ANTHROPIC_API_KEY=
