# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/
.npm/
.pnp
.pnp.js

# ─── Build output ────────────────────────────────────────────────────────────
# backend/dist (Nest), frontend/dist (Vite)
dist/
dist-ssr/
build/
*.tsbuildinfo

# ─── Environment ─────────────────────────────────────────────────────────────
# .env.example IS committed — it documents what a reviewer may override.
# Dev defaults live in compose.yaml so a clean clone runs without a .env.
.env
.env.*
!.env.example
# .env.test IS committed — the e2e suite must be identical on every machine,
# and it holds nothing secret. Host-specific overrides (a non-default DB_PORT)
# go in backend/.env.test.local, which `*.local` below keeps out.
!.env.test
*.local

# ─── Prisma ──────────────────────────────────────────────────────────────────
# prisma/migrations/ MUST be committed — the reviewer runs `prisma migrate deploy`.
# Only ignore a generated client if schema.prisma sets a custom `output` path
# outside node_modules; the default location is already covered above.
# It lives under src/ so it stays inside the build's rootDir.
backend/src/generated/


# ─── Tests / coverage ────────────────────────────────────────────────────────
coverage/
*.lcov
.nyc_output/
test-results/

# ─── Runtime artifacts ───────────────────────────────────────────────────────
# Uploaded CSVs land here (no S3 per SPEC). Path-scoped on purpose:
# never ignore by extension — `*.csv` would silently drop fixtures/.
uploads/
tmp/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Caches ──────────────────────────────────────────────────────────────────
.vite/
.cache/
.eslintcache
.turbo/

# ─── Editor / OS ─────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

CLAUDE.md
**/superpowers