# Overrides only. A clean clone runs without a .env — every value below is
# already the default baked into compose.yaml. Copy this file to .env if you
# need to change one (e.g. DB_PORT, because you already run Postgres on 5432).
#
# These are dev credentials for a container bound to localhost. They are not
# secrets. Anything that IS a secret (JWT_SECRET, LLM API key) must NOT get a
# default like this — it must fail fast when missing outside development.

# --- Postgres container (consumed by compose.yaml) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=smart_contact_importer
DB_PORT=5432

# --- Application (consumed by the backend + Prisma CLI) ---
# Redundant with the four values above: compose needs them split, Prisma needs
# them as one URL. Change one side, change the other.
DATABASE_URL=postgresql://app:app@localhost:5432/smart_contact_importer?schema=public
