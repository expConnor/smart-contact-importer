# Overrides only — compose.yaml carries all four as inline defaults, so a clean
# clone runs without a .env. Copy to .env only to change one.
#
# Read by `docker compose` interpolation, nothing else. Dev credentials for a
# container bound to localhost: not secrets.

POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=smart_contact_importer

# Change this and change DATABASE_URL in backend/.env to match.
DB_PORT=5432
